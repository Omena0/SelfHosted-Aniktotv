{
  "name": "anistash-play",
  "version": "1.0.0",
  "description": "Self-hosted anime streaming server with AniList integration",
  "main": "site/server/index.js",
  "type": "module",
  "scripts": {
    "start": "node site/server/index.js",
    "install": "npm install --prefix site/server && npm install --prefix site/client",
    "build": "npm run build --prefix site/client",
    "dev:server": "node site/server/index.js",
    "dev:client": "npm run dev --prefix site/client"
  },
  "keywords": [
    "anime",
    "streaming",
    "self-hosted",
    "anilist",
    "media-server"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
